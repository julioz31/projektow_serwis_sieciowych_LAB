{
  "info": {
    "name": "Lab2 Books API Tests with Middleware",
    "_postman_id": "lab2-books-middleware-001",
    "description": "CRUD тестування + перевірка middleware (X-Process-Time, Admin Guard)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /books",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/books", "host": ["{{baseUrl}}"], "path": ["books"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is array', function () { var jsonData = pm.response.json(); pm.expect(jsonData).to.be.an('array'); });",
              "pm.test('X-Process-Time header exists', function() { pm.response.to.have.header('X-Process-Time'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /books",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"1984\",\n  \"author\": \"George Orwell\",\n  \"price\": 29.99,\n  \"tags\": [\"dystopia\",\"classic\"]\n}" },
        "url": { "raw": "{{baseUrl}}/books", "host": ["{{baseUrl}}"], "path": ["books"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Has id', function () { var jsonData = pm.response.json(); pm.expect(jsonData).to.have.property('id'); pm.environment.set('bookId', jsonData.id); });",
              "pm.test('X-Process-Time header exists', function() { pm.response.to.have.header('X-Process-Time'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /books/{id}",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/books/{{bookId}}", "host": ["{{baseUrl}}"], "path": ["books","{{bookId}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('ID matches', function () { var jsonData = pm.response.json(); pm.expect(jsonData.id).to.eql(parseInt(pm.environment.get('bookId'))); });",
              "pm.test('X-Process-Time header exists', function() { pm.response.to.have.header('X-Process-Time'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT /books/{id}",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"1984 - Updated\",\n  \"author\": \"George Orwell\",\n  \"price\": 34.99,\n  \"tags\": [\"dystopia\",\"classic\",\"updated\"]\n}" },
        "url": { "raw": "{{baseUrl}}/books/{{bookId}}", "host": ["{{baseUrl}}"], "path": ["books","{{bookId}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Title updated', function () { var jsonData = pm.response.json(); pm.expect(jsonData.title).to.eql('1984 - Updated'); });",
              "pm.test('X-Process-Time header exists', function() { pm.response.to.have.header('X-Process-Time'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE /books/{id}",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/books/{{bookId}}", "host": ["{{baseUrl}}"], "path": ["books","{{bookId}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 204', function () { pm.response.to.have.status(204); });",
              "pm.test('X-Process-Time header exists', function() { pm.response.to.have.header('X-Process-Time'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET deleted /books/{id}",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/books/{{bookId}}", "host": ["{{baseUrl}}"], "path": ["books","{{bookId}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 404', function () { pm.response.to.have.status(404); });",
              "pm.test('Detail is Book not found', function () { var jsonData = pm.response.json(); pm.expect(jsonData.detail).to.eql('Book not found'); });",
              "pm.test('X-Process-Time header exists', function() { pm.response.to.have.header('X-Process-Time'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /admin/secret without key",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/admin/secret", "host": ["{{baseUrl}}"], "path": ["admin","secret"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 401', function () { pm.response.to.have.status(401); });",
              "pm.test('Detail is Unauthorized', function () { var jsonData = pm.response.json(); pm.expect(jsonData.detail).to.include('Unauthorized'); });",
              "pm.test('X-Process-Time header exists', function() { pm.response.to.have.header('X-Process-Time'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /admin/secret with key",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
        "url": { "raw": "{{baseUrl}}/admin/secret", "host": ["{{baseUrl}}"], "path": ["admin","secret"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Message welcome', function () { var jsonData = pm.response.json(); pm.expect(jsonData.msg).to.include('Welcome'); });",
              "pm.test('X-Process-Time header exists', function() { pm.response.to.have.header('X-Process-Time'); });"
            ]
          }
        }
      ]
    }
  ]
}
